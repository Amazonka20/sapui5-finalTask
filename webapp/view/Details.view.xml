<mvc:View
  controllerName="finalproject.controller.Details"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
>
  <Page id="detailsPage">
    <customHeader>
      <Toolbar>
        <Button icon="sap-icon://nav-back" type="Transparent" press="onNavBack" />
        <ToolbarSpacer />
        <Button text="Edit" press="onEdit" visible="{= !${view>/editMode} }" />
        <Button text="Save" type="Emphasized" press="onSave" visible="{view>/editMode}" />
        <Button text="Cancel" press="onCancel" visible="{view>/editMode}" />
        <Button
          text="Delete Order"
          type="Reject"
          press="onDelete"
          visible="{= !${view>/editMode} }"
        />
      </Toolbar>
    </customHeader>
    <HBox class="sapUiSmallMargin">
      <Title text="Order: {OrderID}" />
    </HBox>
    <HBox class="sapUiSmallMargin">
      <Title text="Customer: {Customer/Name}" />
    </HBox>

    <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
      <VBox class="sapUiContentPadding">
        <Text text="Order date" />
        <Text
          text="{ path: 'OrderDate', formatter: '.formatter.formatDate' }"
          visible="{= !${view>/editMode} }"
        />
        <DatePicker
          dateValue="{OrderDate}"
          displayFormat="dd MMM yyyy"
          visible="{view>/editMode}"
        />

        <Text text="Required date" class="sapUiSmallMarginTop" />
        <Text
          text="{ path: 'RequiredDate', formatter: '.formatter.formatDate' }"
          visible="{= !${view>/editMode} }"
        />
        <DatePicker
          dateValue="{RequiredDate}"
          displayFormat="dd MMM yyyy"
          visible="{view>/editMode}"
        />

        <Text text="Shipped date" class="sapUiSmallMarginTop" />
        <Text
          text="{ path: 'ShippedDate', formatter: '.formatter.formatDate' }"
          visible="{= !${view>/editMode} }"
        />
        <DatePicker
          dateValue="{ShippedDate}"
          displayFormat="dd MMM yyyy"
          visible="{view>/editMode}"
        />
      </VBox>

      <VBox class="sapUiContentPadding">
        <Text text="Freight" />
        <Text
          text="{ parts: [ {path: 'Freight'}, {path: 'Currency'} ], type: 'sap.ui.model.type.Currency' }"
        />
      </VBox>
    </HBox>
    <Table id="orderItemsTable2" headerText="Order items" items="{Items}">
      <columns>
        <Column>
          <Text text="Product ID" />
        </Column>
        <Column>
          <Text text="Product Name" />
        </Column>
        <Column>
          <Text text="Quantity" />
        </Column>
        <Column>
          <Text text="Unit Price" />
        </Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <Text text="{ProductID}" />
            <Text text="{Product/Name}" />

            <VBox>
              <Text text="{= ${Quantity} + ' pcs' }" visible="{= !${view>/editMode} }" />
              <Input value="{Quantity}" type="Number" visible="{view>/editMode}" />
            </VBox>

            <VBox>
              <Text
                text="{ parts: [ {path: 'UnitPrice'}, {path: 'Currency'} ], type: 'sap.ui.model.type.Currency' }"
              />
            </VBox>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </Page>
</mvc:View>
