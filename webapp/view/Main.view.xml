<mvc:View
  controllerName="finalproject.controller.Main"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:smart="sap.ui.comp.smarttable"
>
  <Page title="Orders">
    <subHeader>
      <Toolbar>
        <ToolbarSpacer />
        <Button text="Create Order" type="Emphasized" press="onCreateOrder" />
      </Toolbar>
    </subHeader>
    <smart:SmartTable
      id="ordersTable"
      header="Orders catalog"
      entitySet="Orders"
      tableType="ResponsiveTable"
      enableAutoBinding="true"
      showRowCount="true"
      initiallyVisibleFields="OrderID,RequiredDate,ShippedDate,Freight"
      useVariantManagement="true"
      useTablePersonalisation="true"
      beforeRebindTable="onBeforeRebindTable"
    >
      <Table>
        <columns>
          <Column hAlign="Left">
            <customData>
              <core:CustomData
                key="p13nData"
                value='{"columnKey":"CustomerName","leadingProperty":"Customer/Name"}'
                writeToDom="true"
              />
            </customData>
            <Text text="Customer" />
          </Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press="onOrderPress">
            <cells>
              <Text text="{Customer/Name}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </smart:SmartTable>
  </Page>
</mvc:View>
