<mvc:View
  controllerName="finalproject.controller.Main"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:smart="sap.ui.comp.smarttable"
  xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
  core:require="{ formatter: 'finalproject/model/formatter' }"
>
  <Page>
    <smartFilterBar:SmartFilterBar id="ordersFilterBar" entitySet="Orders" liveMode="true">
      <smartFilterBar:controlConfiguration>
        <smartFilterBar:ControlConfiguration key="OrderID" visibleInAdvancedArea="true" />
        <smartFilterBar:ControlConfiguration key="CustomerID" visibleInAdvancedArea="true" />
      </smartFilterBar:controlConfiguration>
    </smartFilterBar:SmartFilterBar>

    <smart:SmartTable
      id="ordersTable"
      smartFilterId="ordersFilterBar"
      header="Orders catalog"
      enableCopy="false"
      entitySet="Orders"
      tableType="ResponsiveTable"
      enableAutoBinding="true"
      showRowCount="true"
      initiallyVisibleFields="OrderID,RequiredDate,ShippedDate,Freight"
      beforeRebindTable="onBeforeRebindTable"
    >
      <smart:customToolbar>
        <OverflowToolbar>
          <ToolbarSpacer />
          <Button text="Create Order" type="Emphasized" press="onCreateOrder" />
        </OverflowToolbar>
      </smart:customToolbar>
      <Table>
        <columns>
          <Column hAlign="Left">
            <customData>
              <core:CustomData
                key="p13nData"
                value='{"columnKey":"CustomerName","leadingProperty":"Customer/Name"}'
                writeToDom="true"
              />
            </customData>
            <Text text="Customer" />
          </Column>

          <Column hAlign="Left">
            <customData>
              <core:CustomData
                key="p13nData"
                value='{"columnKey":"ShippedDate","leadingProperty":"ShippedDate", "columnIndex":"3"}'
                writeToDom="true"
              />
            </customData>
            <Text text="Shipped Date" />
          </Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press="onOrderPress">
            <cells>
              <Text text="{Customer/Name}" />
              <Text text="{path: 'ShippedDate', formatter: 'formatter.formatDate'}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </smart:SmartTable>
  </Page>
</mvc:View>
