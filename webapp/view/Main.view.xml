<mvc:View
  controllerName="finalproject.controller.Main"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
>
  <Page title="Orders">
    <subHeader>
      <Toolbar>
        <ToolbarSpacer />
        <Label text="Customers" />
        <ComboBox
          id="filter"
          items="{/Customers}"
          selectedKey="{view>/selectedFilterKey}"
          selectionChange="onFilter"
          width="30%"
          showClearIcon="true"
        >
          <core:Item key="{ID}" text="{Name}" />
        </ComboBox>
      </Toolbar>
    </subHeader>
    <List id="orderList" items="{path: '/Orders', parameters: { expand: 'Customer' }}">
      <ObjectListItem
        title="Order #{OrderID}"
        intro="{Customer/Name}"
        number="{Freight}"
        numberUnit="USD"
        press="onPress"
        type="Navigation"
      >
        <attributes>
          <ObjectAttribute
            title="Required"
            text="{path: 'RequiredDate', formatter: '.formatter.formatDate'}"
          />
          <ObjectAttribute
            title="Shipped"
            text="{path: 'ShippedDate', formatter: '.formatter.formatDate'}"
          />
        </attributes>
      </ObjectListItem>
    </List>
  </Page>
</mvc:View>
