<mvc:View
  controllerName="finalproject.controller.CreateOrder"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
>
  <Page>
    <customHeader>
      <Toolbar>
        <Button icon="sap-icon://nav-back" type="Transparent" press="onNavBack" />
        <Title text="New Order" class="sapUiSmallMarginBegin" />
        <ToolbarSpacer />
      </Toolbar>
    </customHeader>
    <content>
      <VBox class="sapUiSmallMargin">
        <Label
          text="{= 'Order ID' + (${view>/orderCreated} ? '' : ' (will be filled after creation)') }"
        />
        <Input value="{OrderID}" editable="false" />
        <Label text="Customer" class="sapUiSmallMarginTop" required="true" />
        <ComboBox id="customerSelect" items="{/Customers}" selectedKey="{CustomerID}">
          <core:Item key="{ID}" text="{Name}" />
        </ComboBox>

        <Label text="Order Date" class="sapUiSmallMarginTop" required="true" />
        <DatePicker id="orderDatePicker" dateValue="{OrderDate}" displayFormat="dd MMM yyy" />

        <Label text="Required Date" class="sapUiSmallMarginTop" required="true" />
        <DatePicker id="requiredDatePicker" dateValue="{RequiredDate}" displayFormat="dd MMM yyy" />

        <Label text="Shipped Date" class="sapUiSmallMarginTop" />
        <DatePicker dateValue="{ShippedDate}" displayFormat="dd MMM yyy" />
        <Button
          text="Create order"
          press="onCreateOrder"
          enabled="{= !${view>/orderCreated} }"
          class="sapUiSmallMarginTop"
        />
        <Text
          text="Create the order first to add products"
          class="sapUiSmallMarginTop"
          visible="{= !${view>/orderCreated} }"
        />

        <Table id="productsTable" items="{/Products}" class="sapUiSmallMarginTop">
          <columns>
            <Column>
              <Text text="Name" />
            </Column>
            <Column>
              <Text text="Price" />
            </Column>
            <Column>
              <Text text="Quantity" />
            </Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{Name}" />
                <Text text="{Price}" />
                <Input value="{orderItem>Quantity}" type="Number" editable="{view>/orderCreated}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
    <footer>
      <Toolbar>
        <Button
          text="Save"
          press="onAddItems"
          enabled="{view>/orderCreated}"
          class="sapUiSmallMargin"
          type="Emphasized"
        />
        <ToolbarSpacer />
      </Toolbar>
    </footer>
  </Page>
</mvc:View>
